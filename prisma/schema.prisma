generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  size      Int
  key       String   @db.VarChar(255)
  url       String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("usuário")
}
